*------------------------------------------------------------------------------
$GLOBAL;
     ref $EXPER = c251b;
*                                                      +------------+
*                         PI revision number:          |    7.0000  |
*                                                      +------------+
*    mode:       4096-8-2
*------------------------------------------------------------------------------
$EXPER;
*
def c251b;
     exper_name = c251b;
     exper_description = "GMVA Apr. 2025";
     PI_name = "Global mm-VLBI Array (GMVA)";
     PI_email = tkrichbaum@mpifr-bonn.mpg.de;
*    address:   Max-Planck-Institut fuer Radioastronomie
*               Auf dem Huegel 69
*               53121 Bonn
*               Germany
*    phone:     0049-228-525-295
*    during obs:0049-2257-301-155
*    fax:       0049-2257-301-106
*    notes:     using Sched 11.8
*
*    year, doy: 2025, 115
*    date     : Fri 25 Apr 2025
*    MJD      : 60790
     exper_nominal_start=2025y115d15h00m00s;
     exper_nominal_stop=2025y116d18h53m00s;
*
     target_correlator = BONN;
*
*    integr_time    :     0.500 s
*    number_channels:   256
*    number_antenna : 20
*    cross_polarize : Yes
*    weight_func    : UNIFORM
*    distrib_medium : FTP
*    distrib_format : FITS
*    source_pos_cat : STANDARD
*    distribute_to  : 
*                     H. Rottmann
*                     Max-Planck-Institut fuer Radioastronomie
*                     Auf dem Huegel 69
*                     D-53121 Bonn, Germany
*    corr_notes : 
*               dual polarisation setup using 64/128 MHz channels
*               VLBA at 86 GHz, SiO maser pointing at 43 GHz
*               please use latest station coordinates
*
enddef;
*------------------------------------------------------------------------------
$MODE;
*
def 86ghz;
     ref $PROCEDURES = Mode_01;
     ref $FREQ = 86076.00MHz16x64MHz#03:Ky:Ku:Kt:Kc;
     ref $FREQ = 86012.00MHz4x64MHz:At;

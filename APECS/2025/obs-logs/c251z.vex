*------------------------------------------------------------------------------
$GLOBAL;
     ref $EXPER = c251z;
*                                                      +------------+
*                         PI revision number:          |    3.0000  |
*                                                      +------------+
*    mode:       4096-8-2
*------------------------------------------------------------------------------
$EXPER;
*
def c251z;
     exper_name = c251z;
     exper_description = "100GHz Test, Apr. 28, 2025";
     PI_name = "Daewon Kim";
     PI_email = dwkim@mpifr-bonn.mpg.de;
*    address:   Max-Planck-Institut fuer Radioastronomie
*               Auf dem Huegel 69
*               53121 Bonn
*               Germany
*    phone:     1-240-495-4708
*    during obs:TBD
*    fax:        
*    notes:     using Sched 11.8
*               Two frequencies 104/114 GHz
*               IRAM 30-m, NOEMA, APEX, Onsala will join
*
*    year, doy: 2025, 118
*    date     : Mon 28 Apr 2025
*    MJD      : 60793
     exper_nominal_start=2025y118d01h00m00s;
     exper_nominal_stop=2025y118d04h49m50s;
*
     target_correlator = BONN;
*
*    integr_time    :     0.500 s
*    number_channels:   256
*    number_antenna : 20
*    cross_polarize : Yes
*    weight_func    : UNIFORM
*    distrib_medium : FTP
*    distrib_format : FITS
*    source_pos_cat : STANDARD
*    distribute_to  : 
*                     H. Rottmann
*                     Max-Planck-Institut fuer Radioastronomie
*                     Auf dem Huegel 69
*                     D-53121 Bonn, Germany
*    corr_notes : 
*               dual polarisation setup using 64/128 MHz channels
*               VLBA at 104 & 114 GHz, SiO maser pointing at 43 GHz
*               usual GMVA setup but just higher base frequency
*               please use latest station coordinates
*
enddef;
*------------------------------------------------------------------------------
$MODE;
*
def 104ghz;
     ref $PROCEDURES = Mode_01;
     ref $FREQ = 104076.00MHz16x64MHz:On:Pv:Ax;
     ref $FREQ = 104012.00MHz2x512MHz:Nn;
     ref $IF = LO@103500MHzDPolNoTone:On:Nn;
     ref $IF = LO@103500MHzDPolNoTone#02:Pv:Ax;
     ref $BBC = 16BBCs:On;
     ref $BBC = 16BBCs#02:Pv:Ax;
     ref $BBC = 2BBCs:Nn;
     ref $TRACKS = VDIF.16Ch2bit1to1:On:Pv:Ax;
     ref $TRACKS = VDIF.2Ch2bit1to1:Nn;
*    ref $HEAD_POS = DiskVoid <= obsolete definition
     ref $ROLL = NoRoll:On:Pv:Nn:Ax;
*    ref $PASS_ORDER = DiskVoid <= obsolete definition
     ref $PHASE_CAL_DETECT = NoDetect:On:Pv:Ax;
     ref $PHASE_CAL_DETECT = NoDetect#02:Nn;
enddef;
*
def 114ghz;
     ref $PROCEDURES = Mode_02;
     ref $FREQ = 114076.00MHz16x64MHz:On:Pv:Ax;
     ref $FREQ = 114012.00MHz2x512MHz:Nn;
     ref $IF = LO@113500MHzDPolNoTone:On:Nn;
     ref $IF = LO@113500MHzDPolNoTone#02:Pv:Ax;
     ref $BBC = 16BBCs:On;
     ref $BBC = 16BBCs#02:Pv:Ax;
     ref $BBC = 2BBCs:Nn;
     ref $TRACKS = VDIF.16Ch2bit1to1:On:Pv:Ax;
     ref $TRACKS = VDIF.2Ch2bit1to1:Nn;
*    ref $HEAD_POS = DiskVoid <= obsolete definition
     ref $ROLL = NoRoll:On:Pv:Nn:Ax;
*    ref $PASS_ORDER = DiskVoid <= obsolete definition
     ref $PHASE_CAL_DETECT = NoDetect#03:On:Pv:Ax;
     ref $PHASE_CAL_DETECT = NoDetect#04:Nn;
enddef;
*------------------------------------------------------------------------------
$STATION;
*
def On;
     ref $SITE = ONSALA60;
     ref $ANTENNA = ONSALA60;
     ref $DAS = 2NONE<;
enddef;
*
def Pv;
     ref $SITE = PICOVEL;
     ref $ANTENNA = PICOVEL;
     ref $DAS = 2NONE<;
enddef;
*
def Nn;
     ref $SITE = NOEMA;
     ref $ANTENNA = NOEMA;
     ref $DAS = 2NONE<;
enddef;
*
def Ax;
     ref $SITE = APEX;
     ref $ANTENNA = APEX;
     ref $DAS = 2NONE<#02;
enddef;
*------------------------------------------------------------------------------
$PROCEDURES;
*
def Mode_01;
     procedure_name_prefix =  "01";
     tape_change =  420 sec;
     headstack_motion =    6 sec;
     new_source_command =    5 sec;
     new_tape_setup =   20 sec;
     setup_always = on :  20 sec;
     parity_check = off : 100 sec;
     tape_prepass = off : 600 sec;
     preob_cal  = on :  10 sec : preob;
     midob_cal  = on :  15 sec : midob;
     postob_cal = on :   0 sec : postob;
enddef;
*
def Mode_02;
     procedure_name_prefix =  "02";
     tape_change =  420 sec;
     headstack_motion =    6 sec;
     new_source_command =    5 sec;
     new_tape_setup =   20 sec;
     setup_always = on :  20 sec;
     parity_check = off : 100 sec;
     tape_prepass = off : 600 sec;
     preob_cal  = on :  10 sec : preob;
     midob_cal  = on :  15 sec : midob;
     postob_cal = on :   0 sec : postob;
enddef;
*------------------------------------------------------------------------------
$SITE;
*

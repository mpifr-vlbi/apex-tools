$MODE;
*
def 86ghz;
     ref $PROCEDURES = Mode_01;
     ref $FREQ = 86012.00MHz8x128MHz:Aa:Nl:Fd:Pt:La:Ov:Kp:Br:Gb;
     ref $FREQ = 86076.00MHz16x64MHz:Ax;
     ref $IF = LO@85500MHzDPolNoTone#03:Aa;
     ref $IF = LO@85500MHzDPolNoTone#04:Ax;
     ref $IF = LO@85500MHzDPolNoTone:Nl:Fd:Pt:La:Ov:Kp:Br;
     ref $IF = LO@85500MHzDPolNoTone#02:Gb;
     ref $BBC = 8BBCs#03:Aa;
     ref $BBC = 16BBCs:Ax;
     ref $BBC = 8BBCs:Nl:Fd:Pt:La:Ov:Kp:Br;
     ref $BBC = 8BBCs#02:Gb;
     ref $TRACKS = VDIF.8Ch2bit1to1#02:Aa;
     ref $TRACKS = VDIF.16Ch2bit1to1:Ax;
     ref $TRACKS = VDIF.8Ch2bit1to1:Nl:Fd:Pt:La:Ov:Kp:Br:Gb;
*    ref $HEAD_POS = DiskVoid <= obsolete definition
     ref $ROLL = NoRoll:Aa:Ax:Nl:Fd:Pt:La:Ov:Kp:Br:Gb;
*    ref $PASS_ORDER = DiskVoid <= obsolete definition
     ref $PHASE_CAL_DETECT = NoDetect:Aa:Nl:Fd:Pt:La:Ov:Kp:Br:Gb;
     ref $PHASE_CAL_DETECT = NoDetect#02:Ax;
enddef;

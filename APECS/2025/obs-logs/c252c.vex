* mode =  4    stations =Nl:Fd:Pt:La:Kp:Ov:Br:Mk
* mode =  5    stations =Nl:Fd:Pt:La:Kp:Ov:Br:Mk
* mode =  6    stations =Nl:Fd:Pt:La:Kp:Ov:Br:Mk
* mode =  7    stations =Nl:Fd:Pt:La:Kp:Ov:Br:Mk
* mode =  8    stations =Nl:Fd:Pt:La:Kp:Ov:Br:Mk
* mode =  9    stations =Nl:Fd:Pt:La:Kp:Ov:Br:Mk
* mode = 10    stations =Nl:Fd:Pt:La:Kp:Ov:Br:Mk
* mode = 11    stations =Nl:Fd:Pt:La:Kp:Ov:Br:Mk
* mode = 12    stations =Nl:Fd:Pt:La:Kp:Ov:Br:Mk
*    firmware_type = RDBE_DDC;
*    format = VDIF, and fan-out = 1
*    mode requires   4.00Mb/s/tr; stations using disks
     track_frame_format = VDIF5032;
     fanout_def =   : &CH01 : sign : 1:  1;
     fanout_def =   : &CH01 :  mag : 1:  1;
     fanout_def =   : &CH02 : sign : 1:  2;
     fanout_def =   : &CH02 :  mag : 1:  2;
     fanout_def =   : &CH03 : sign : 1:  3;
     fanout_def =   : &CH03 :  mag : 1:  3;
     fanout_def =   : &CH04 : sign : 1:  4;
     fanout_def =   : &CH04 :  mag : 1:  4;
enddef;

     antenna_motion = el :  15.0 deg/min : 20 sec;  *    0.018 deg/sec/sec
     antenna_motion = az :  25.0 deg/min : 20 sec;  *    0.018 deg/sec/sec
     axis_offset =    0.01310 m;
enddef;

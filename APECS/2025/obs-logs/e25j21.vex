*------------------------------------------------------------------------------
$GLOBAL;
     ref $EXPER = e25j21;
*                                                      +------------+
*                         PI revision number:          |    6.0000  |
*                                                      +------------+
*    mode:       R2DBE
*------------------------------------------------------------------------------
$EXPER;
*
def e25j21;
     exper_name = e25j21;
     exper_description = "EHT Dress Rehearsal January 2025";
     PI_name = "EHTC";
     PI_email = not@an.address;
*    address:   The Event Horizon Telescope Collaboration
*               Global
*                
*                
*    phone:     TBD
*    during obs:TBD
*    fax:        
*    notes:     Double-check Solar avoidance for each day of production
*               APEX 30 deg, LMT 30, NOEMA 32, SMA 25, SMT 45
*               Subarraying is used in this schedule
*
*    year, doy: 2025,  21
*    date     : Tue 21 Jan 2025
*    MJD      : 60696
     exper_nominal_start=2025y021d05h14m00s;
     exper_nominal_stop=2025y021d08h07m00s;
*
     target_correlator = HAYSTACK;
*
*    integr_time    :     1.000 s
*    number_channels:    64
*    number_antenna :  8
*    cross_polarize : Yes
*    weight_func    : UNIFORM
*    distrib_medium : FTP
*    distrib_format : FITS
*    source_pos_cat : STANDARD
*
enddef;
*------------------------------------------------------------------------------
$MODE;
*
def band6;
     ref $PROCEDURES = Mode_01;
     ref $FREQ = 226100.00MHz1x2048MHz:Gl:Sw:Mm:Pc:Ky:Lm:Nn:Pv:Aa;
     ref $IF = LO@226084MHzLPolNoTone:Gl:Sw:Mm:Pc:Ky:Lm:Nn:Pv:Aa;
     ref $BBC = 1BBCs:Gl:Sw:Mm:Pc:Ky:Lm:Nn:Pv:Aa;
     ref $TRACKS = MARK5B.1Ch2bit1to1:Gl:Sw:Mm:Pc:Ky:Lm:Nn:Pv:Aa;
*    ref $HEAD_POS = DiskVoid <= obsolete definition
     ref $ROLL = NoRoll:Gl:Sw:Mm:Pc:Ky:Lm:Nn:Pv:Aa;
*    ref $PASS_ORDER = DiskVoid <= obsolete definition
     ref $PHASE_CAL_DETECT = NoDetect:Gl:Sw:Mm:Pc:Ky:Lm:Nn:Pv:Aa;
enddef;
*------------------------------------------------------------------------------
$STATION;
*
def Gl;
     ref $SITE = THULE;
     ref $ANTENNA = THULE;
     ref $DAS = 2NONE<;
enddef;
*
def Sw;
     ref $SITE = SMAP;
     ref $ANTENNA = SMAP;
     ref $DAS = 2NONE<;
enddef;
*
def Mm;
     ref $SITE = JCMT;
     ref $ANTENNA = JCMT;
     ref $DAS = 2NONE<;
enddef;
*
def Pc;
     ref $SITE = KVNPC;
     ref $ANTENNA = KVNPC;
     ref $DAS = 2NONE+MARK5B<;
enddef;
*
def Ky;
     ref $SITE = KVNYS;
     ref $ANTENNA = KVNYS;
     ref $DAS = 2NONE+MARK5B<;
enddef;
*
def Lm;
     ref $SITE = LMT;
     ref $ANTENNA = LMT;
     ref $DAS = 2NONE<;
enddef;
*
def Nn;
     ref $SITE = NOEMA;
     ref $ANTENNA = NOEMA;
     ref $DAS = 2NONE<;
enddef;
*
def Pv;
     ref $SITE = PICOVEL;
     ref $ANTENNA = PICOVEL;
     ref $DAS = 2NONE<;
enddef;
*
def Aa;
     ref $SITE = ALMA;
     ref $ANTENNA = ALMA;
     ref $DAS = 2NONE<#02;
enddef;
*------------------------------------------------------------------------------
$PROCEDURES;
*
def Mode_01;
     procedure_name_prefix =  "01";
     tape_change =  420 sec;
     headstack_motion =    6 sec;
     new_source_command =    5 sec;
     new_tape_setup =   20 sec;
     setup_always = on :  20 sec;
     parity_check = off : 100 sec;
     tape_prepass = off : 600 sec;
     preob_cal  = on :  10 sec : preob;
     midob_cal  = on :  15 sec : midob;
     postob_cal = on :   0 sec : postob;
enddef;

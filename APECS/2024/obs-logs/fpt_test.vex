*------------------------------------------------------------------------------
$FREQ;
*
def DualFreq8x512MHz;
* mode =  1    stations =Ax:Pv
     sample_rate =  1024.000 Ms/sec;  * (2bits/sample)
     chan_def = : 86012.00 MHz : U : 512.00 MHz : &CH01 : &BBC01 : &NoCal; *Rcp
     chan_def = : 86524.00 MHz : U : 512.00 MHz : &CH02 : &BBC01 : &NoCal; *Rcp
     chan_def = :258036.00 MHz : U : 512.00 MHz : &CH03 : &BBC02 : &NoCal; *Rcp
     chan_def = :258548.00 MHz : U : 512.00 MHz : &CH04 : &BBC02 : &NoCal; *Rcp
     chan_def = : 86012.00 MHz : U : 512.00 MHz : &CH05 : &BBC03 : &NoCal; *Lcp
     chan_def = : 86524.00 MHz : U : 512.00 MHz : &CH06 : &BBC03 : &NoCal; *Lcp
     chan_def = :258036.00 MHz : U : 512.00 MHz : &CH07 : &BBC04 : &NoCal; *Lcp
     chan_def = :258548.00 MHz : U : 512.00 MHz : &CH08 : &BBC04 : &NoCal; *Lcp
enddef;
*------------------------------------------------------------------------------
$IF;
*
def DualFreqDPolNoTone;
* mode =  1    stations =Ax:Pv
     if_def = &IF_A1 : A1 : R : 93012.00 MHz : L ; * PCall off!   0.0   0.0  NA     0 NA
     if_def = &IF_B4 : B4 : L : 93012.00 MHz : L ; * PCall off!   0.0   0.0  NA     0 NA
enddef;
*------------------------------------------------------------------------------
$BBC;
*
def 8BBCs;
* mode =  1    stations =Ax:Pv
     BBC_assign = &BBC01 :  1 : &IF_A1;
     BBC_assign = &BBC02 :  2 : &IF_A1;
     BBC_assign = &BBC03 :  3 : &IF_B4;
     BBC_assign = &BBC04 :  4 : &IF_B4;
enddef;
*------------------------------------------------------------------------------
$PHASE_CAL_DETECT;
*
def NoDetect;
* mode =  1    stations =Ax:Pv
     phase_cal_detect = &NoCal;
enddef;
*------------------------------------------------------------------------------
$TRACKS;
*
def VDIF.8Ch2bit1to1;
* mode =  1    stations =Ax:Pv
*    format = VDIF, and fan-out = 1
*    mode requires ******Mb/s/tr; stations using disks
     track_frame_format = VDIF5032;
     fanout_def =   : &CH01 : sign : 1:  1;
     fanout_def =   : &CH01 :  mag : 1:  1;
     fanout_def =   : &CH02 : sign : 1:  2;
     fanout_def =   : &CH02 :  mag : 1:  2;
     fanout_def =   : &CH03 : sign : 1:  3;
     fanout_def =   : &CH03 :  mag : 1:  3;
     fanout_def =   : &CH04 : sign : 1:  4;
     fanout_def =   : &CH04 :  mag : 1:  4;
     fanout_def =   : &CH05 : sign : 1:  5;
     fanout_def =   : &CH05 :  mag : 1:  5;
     fanout_def =   : &CH06 : sign : 1:  6;
     fanout_def =   : &CH06 :  mag : 1:  6;
     fanout_def =   : &CH07 : sign : 1:  7;
     fanout_def =   : &CH07 :  mag : 1:  7;
     fanout_def =   : &CH08 : sign : 1:  8;
     fanout_def =   : &CH08 :  mag : 1:  8;
enddef;
*------------------------------------------------------------------------------
$HEAD_POS;
def DiskVoid;
* mode =  1    stations =Ax:Pv
*     Head positions irrelevant for Disk: empty def
enddef;
*------------------------------------------------------------------------------
$PASS_ORDER;
*
def DiskVoid;
* mode =  1    stations =Ax:Pv
*     Pass orders irrelevant for Disk: empty def
enddef;
*------------------------------------------------------------------------------
$ROLL;
*
def NoRoll;
* mode =  1    stations =Ax:Pv
*    barrel-roll set to 'roll_off', so reverse-roll by  0 (1 head)
     roll = off;
enddef;

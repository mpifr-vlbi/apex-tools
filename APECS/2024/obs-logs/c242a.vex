*
def c242a;
     exper_name = c242a;
     exper_description = "GMVA Oct. 2024";
     PI_name = "Global mm-VLBI Array (GMVA)";
     PI_email = tkrichbaum@mpifr-bonn.mpg.de;
*    address:   Max-Planck-Institut fuer Radioastronomie
*               Auf dem Huegel 69
*               53121 Bonn
*               Germany
*    phone:     0049-228-525-295
*    during obs:0049-2257-301-155
*    fax:       0049-2257-301-106
*    notes:     using Sched 12.0, pre-release
*
*    year, doy: 2024, 284
*    date     : Thu 10 Oct 2024
*    MJD      : 60593
     exper_nominal_start=2024y284d16h00m00s;
     exper_nominal_stop=2024y285d03h50m00s;
*
     target_correlator = BONN;
*
*    integr_time    :     0.500 s
*    number_channels:   256
*    number_antenna : 20
*    cross_polarize : Yes
*    weight_func    : UNIFORM
*    distrib_medium : FTP
*    distrib_format : FITS
*    source_pos_cat : STANDARD
*    distribute_to  : 
*                     H. Rottmann
*                     Max-Planck-Institut fuer Radioastronomie
*                     Auf dem Huegel 69
*                     D-53121 Bonn, Germany
*    corr_notes : 
*               dual polarisation setup using 64/128 MHz channels
*                FPT: Ys+KVN 7mm/3mm simultaneous, VLBA 7mm/3mm rapid switch
*               please use latest station coordinates
*
enddef;

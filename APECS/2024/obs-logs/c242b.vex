VEX_rev = 1.5;
*    SCHED vers: Release 11.8; April 2023
*    VEX/SCHED:  1.5.88
*    Other versions: Sched:  11.8  Plot: 1.06  JPL-ephem: 1.01
*------------------------------------------------------------------------------
$GLOBAL;
     ref $EXPER = c242b;
*                                                      +------------+
*                         PI revision number:          |    7.0000  |
*                                                      +------------+
*    mode:       4096-8-2
*------------------------------------------------------------------------------
$EXPER;
*
def c242b;
     exper_name = c242b;
     exper_description = "GMVA Oct. 2024";
     PI_name = "Global mm-VLBI Array (GMVA)";
     PI_email = tkrichbaum@mpifr-bonn.mpg.de;
*    address:   Max-Planck-Institut fuer Radioastronomie
*               Auf dem Huegel 69
*               53121 Bonn
*               Germany
*    phone:     0049-228-525-295
*    during obs:0049-2257-301-155
*    fax:       0049-2257-301-106
*    notes:     using Sched 11.8
*
*    year, doy: 2024, 285
*    date     : Fri 11 Oct 2024
*    MJD      : 60594
     exper_nominal_start=2024y285d04h00m00s;
     exper_nominal_stop=2024y286d03h50m01s;
*
     target_correlator = BONN;
*
*    integr_time    :     0.500 s
*    number_channels:   256
*    number_antenna : 20
*    cross_polarize : Yes
*    weight_func    : UNIFORM
*    distrib_medium : FTP
*    distrib_format : FITS
*    source_pos_cat : STANDARD
*    distribute_to  : 
*                     H. Rottmann
*                     Max-Planck-Institut fuer Radioastronomie
*                     Auf dem Huegel 69
*                     D-53121 Bonn, Germany
*    corr_notes : 
*               dual polarisation setup using 64/128 MHz channels
*               VLBA at 86 GHz, SiO maser pointing at 43 GHz
*               please use latest station coordinates
*
enddef;
*------------------------------------------------------------------------------
$MODE;
*
def 86ghz;
     ref $PROCEDURES = Mode_01;
     ref $FREQ = 86076.00MHz16x64MHz:Ef:On:Pv;
     ref $FREQ = 86076.00MHz16x64MHz#02:Ys:Mh:Ax;
     ref $FREQ = 86012.00MHz2x512MHz:Nn;
     ref $FREQ = 86012.00MHz8x128MHz:Nl:Fd:Pt:La:Ov:Kp:Br:Mk;
     ref $FREQ = 86076.00MHz16x64MHz#03:Ky:Ku:Kt:Kc;
     ref $IF = LO@85500MHzDPolNoTone#02:Ef:On:Nn;
     ref $IF = LO@85500MHzDPolNoTone#04:Ys;
     ref $IF = LO@85500MHzDPolNoTone#03:Pv:Ax;
     ref $IF = LO@85500MHzDPolNoTone#05:Mh;
     ref $IF = LO@85500MHzDPolNoTone:Nl:Fd:Pt:La:Ov:Kp:Br:Mk;
     ref $IF = LO@76800MHzDPolNoTone:Ky:Ku:Kt;
     ref $IF = LO@99000MHzDPolNoTone:Kc;
     ref $BBC = 16BBCs:Ef:On;
     ref $BBC = 16BBCs#03:Ys;
     ref $BBC = 16BBCs#02:Pv;
     ref $BBC = 2BBCs:Nn;
     ref $BBC = 16BBCs#04:Mh;
     ref $BBC = 16BBCs#05:Ax;
     ref $BBC = 8BBCs:Nl:Fd:Pt:La:Ov:Kp:Br:Mk;
     ref $BBC = 8BBCs#02:Ky:Ku:Kt:Kc;
     ref $TRACKS = VDIF.16Ch2bit1to1:Ef:On:Ys:Pv:Mh:Ax:Ky:Ku:Kt:Kc;
     ref $TRACKS = VDIF.2Ch2bit1to1:Nn;
     ref $TRACKS = VDIF.8Ch2bit1to1:Nl:Fd:Pt:La:Ov:Kp:Br:Mk;

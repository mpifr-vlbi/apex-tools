!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!
! GMVA Autumn 2026
!
! The backends containing the VLBI recorded 2-pol x 1-channel x 512 MHz band are:
!   AP-N901-F303    corresponding to RCP(?)
!   AP-N902-F303    corresponding to LCP(?)
!
! The line names were
!   vlbifreq86     88.500 GHz LSB  ! for OCT_D recording 86012--86524 MHz standard GMVA continuum mode
!   vlbifreq88     90.800 GHz LSB  ! for OCT_D recording 88312--88824 MHz incl HCN  in MN006A
!   vlbifreq89     91.500 GHz LSB  ! for OCT_D recording 89012--89524 MHz incl HCO+ in MN006B
!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

define character*500 outputname
define real tscaling
let tscaling = 24/(2*pi)  ! to convert UT Radian into UT Hour

set default

set variable general
set variable position
set variable spectro
set variable calibration
set variable skydip

!! Find all datasets, tell where scan metadata will be extracted to
!! e.g. T-0117.F-9996A-2026-2026-09-29.apex  -->  tau_2026-09-29.txt
sic find *.apex ~/scidata/
say ""
say "== Found these data files under ~/scidata/:"
for fnr 1 to DIR%NFILE
   let outputname = tau_'DIR%FILE[fnr][21:30]'.txt
   say 'DIR%FILE[fnr]'"  -->  "'outputname'
next
say ""

!! For each dataset, extract metadata of every contained scan
!for fnr 1 to 2  ! fewer files just for testing
for fnr 1 to DIR%NFILE

   file in ~/scidata/'DIR%FILE[fnr]'
   let outputname = tau_'DIR%FILE[fnr][21:30]'.txt

   set line VLBI*
   set offset 0 0
   set telescope AP-N901-F303
   find
   set telescope AP-N902-F303
   find append

   sic message class a+i
   sic output 'outputname'
   for t 1 to found
      get next  
      say 'cdobs','tscaling*ut','scan','sourc','el','restf','teles','tau','taus','tsys','tamb'
   next 
   sic out

next

VEX_rev = 1.5;
*    SCHED vers: Release 12.0; March 2025
*    VEX/SCHED:  1.5.88
*    Other versions: Sched:  12.0  Plot: 1.06  JPL-ephem: 1.01
*------------------------------------------------------------------------------
$GLOBAL;
     ref $EXPER = mn006a;
*                                                      +------------+
*                         PI revision number:          |    4.0000  |
*                                                      +------------+
*    mode:       4096-8-2
*------------------------------------------------------------------------------
$EXPER;
*
def mn006a;
     exper_name = mn006a;
     exper_description = "GMVA Sep. 2026";
     PI_name = "Global mm-VLBI Array (GMVA)";
     PI_email = hrottmann@mpifr-bonn.mpg.de;
*    address:   Max-Planck-Institut fuer Radioastronomie
*               Auf dem Huegel 69
*               53121 Bonn
*               Germany
*    phone:     0049-228-525-123
*    during obs:0049-2257-301-155
*    fax:       0049-2257-301-106
*    notes:     using Sched 12.0
*
*    year, doy: 2026, 270
*    date     : Sun 27 Sep 2026
*    MJD      : 61310
     exper_nominal_start=2026y270d22h00m00s;
     exper_nominal_stop=2026y271d14h52m00s;
*
     target_correlator = BONN;
*
*    integr_time    :     0.500 s
*    number_channels:   256
*    number_antenna : 20
*    cross_polarize : Yes
*    weight_func    : UNIFORM
*    distrib_medium : FTP
*    distrib_format : FITS
*    source_pos_cat : STANDARD
*    distribute_to  : 
*                     H. Rottmann
*                     Max-Planck-Institut fuer Radioastronomie
*                     Auf dem Huegel 69
*                     D-53121 Bonn, Germany
*    corr_notes : 
*               dual polarisation setup using 64/128 MHz channels
*               VLBA at 86 GHz, SiO maser pointing at 43 GHz
*               please use latest station coordinates
*               spectral line experiment, HCN line at 88632 MHz
*
enddef;
*------------------------------------------------------------------------------
$MODE;
*
def hcn;
     ref $PROCEDURES = Mode_01;
     ref $FREQ = 88376.00MHz16x64MHz:Ef:On:Pv;
     ref $FREQ = 88312.00MHz2x512MHz:Nn;
     ref $FREQ = 88376.00MHz16x64MHz#02:Mh:Ax;
     ref $FREQ = 88312.00MHz8x128MHz:Gl:Nl:Fd:Ov:Pt:Br:Kp:La:Mk;
     ref $FREQ = 88312.00MHz8x128MHz#02:Ky:Ku:Kt:Kc;
     ref $IF = LO@87800MHzDPolNoTone#03:Ef:On:Nn;
     ref $IF = LO@87800MHzDPolNoTone#04:Pv:Ax;
     ref $IF = LO@87800MHzDPolNoTone#05:Mh;
     ref $IF = LO@87800MHzDPolNoTone#02:Gl;
     ref $IF = LO@99000MHzDPolNoTone:Ky:Kc;
     ref $IF = LO@76800MHzDPolNoTone:Ku:Kt;
     ref $IF = LO@87800MHzDPolNoTone:Nl:Fd:Ov:Pt:Br:Kp:La:Mk;
     ref $BBC = 16BBCs:Ef:On;
     ref $BBC = 16BBCs#02:Pv;
     ref $BBC = 2BBCs:Nn;
     ref $BBC = 16BBCs#03:Mh;
     ref $BBC = 8BBCs#02:Gl;
     ref $BBC = 8BBCs#03:Ky:Ku:Kt:Kc;
     ref $BBC = 8BBCs:Nl:Fd:Ov:Pt:Br:Kp:La:Mk;
     ref $BBC = 16BBCs#04:Ax;
     ref $TRACKS = VDIF.16Ch2bit1to1:Ef:On:Pv:Mh:Ax;
     ref $TRACKS = VDIF.2Ch2bit1to1:Nn;
     ref $TRACKS = VDIF.8Ch2bit1to1#02:Gl:Ky:Ku:Kt:Kc;
     ref $TRACKS = VDIF.8Ch2bit1to1:Nl:Fd:Ov:Pt:Br:Kp:La:Mk;
*    ref $HEAD_POS = DiskVoid <= obsolete definition
     ref $ROLL = NoRoll:Ef:On:Pv:Nn:Mh:Gl:Ky:Ku:Kt:Kc:Nl:Fd:Ov:Pt:Br:Kp:La:Ax:Mk;
*    ref $PASS_ORDER = DiskVoid <= obsolete definition
     ref $PHASE_CAL_DETECT = NoDetect#02:Ef:On:Pv:Mh:Ax;
     ref $PHASE_CAL_DETECT = NoDetect#03:Nn;
     ref $PHASE_CAL_DETECT = NoDetect:Gl:Nl:Fd:Ov:Pt:Br:Kp:La:Mk;
     ref $PHASE_CAL_DETECT = NoDetect#04:Ky:Ku:Kt:Kc;
enddef;

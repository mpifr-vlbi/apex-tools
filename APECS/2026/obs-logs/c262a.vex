VEX_rev = 1.5;
*    SCHED vers: Release 12.0; March 2025
*    VEX/SCHED:  1.5.88
*    Other versions: Sched:  12.0  Plot: 1.06  JPL-ephem: 1.01
*------------------------------------------------------------------------------
$GLOBAL;
     ref $EXPER = c262a;
*                                                      +------------+
*                         PI revision number:          |    7.0000  |
*                                                      +------------+
*    mode:       4096-8-2
*------------------------------------------------------------------------------
$EXPER;
*
def c262a;
     exper_name = c262a;
     exper_description = "GMVA Sep. 2026";
     PI_name = "Global mm-VLBI Array (GMVA)";
     PI_email = hrottmann@mpifr-bonn.mpg.de;
*    address:   Max-Planck-Institut fuer Radioastronomie
*               Auf dem Huegel 69
*               53121 Bonn
*               Germany
*    phone:     0049-228-525-123
*    during obs:0049-2257-301-155
*    fax:       0049-2257-301-106
*    notes:     using Sched 12.0
*
*    year, doy: 2026, 267
*    date     : Thu 24 Sep 2026
*    MJD      : 61307
     exper_nominal_start=2026y267d16h00m00s;
     exper_nominal_stop=2026y269d08h49m20s;
*
     target_correlator = BONN;
*
*    integr_time    :     0.500 s
*    number_channels:   256
*    number_antenna : 20
*    cross_polarize : Yes
*    weight_func    : UNIFORM
*    distrib_medium : FTP
*    distrib_format : FITS
*    source_pos_cat : STANDARD
*    distribute_to  : 
*                     H. Rottmann
*                     Max-Planck-Institut fuer Radioastronomie
*                     Auf dem Huegel 69
*                     D-53121 Bonn, Germany
*    corr_notes : 
*               dual polarisation setup using 64/128 MHz channels
*               VLBA at 86 GHz, SiO maser pointing at 43 GHz
*               please use latest station coordinates
*
enddef;
*------------------------------------------------------------------------------
$MODE;
*
def 86ghz;
     ref $PROCEDURES = Mode_01;
     ref $FREQ = 86076.00MHz16x64MHz:Ef:On:Pv;
     ref $FREQ = 86076.00MHz16x64MHz#02:Mh:Ax;
     ref $FREQ = 86012.00MHz2x512MHz:Nn;
     ref $FREQ = 86012.00MHz8x128MHz:Gl:Nl:Fd:Pt:La:Br:Kp:Ov:Mk:Mm;
     ref $FREQ = 86076.00MHz16x64MHz#03:Ku:Kt:Kc:Ky;
     ref $IF = LO@85500MHzDPolNoTone#03:Ef:On:Nn;
     ref $IF = LO@85500MHzDPolNoTone#05:Mh;
     ref $IF = LO@85500MHzDPolNoTone#04:Pv:Ax;
     ref $IF = LO@85500MHzDPolNoTone#02:Gl:Mm;
     ref $IF = LO@85500MHzDPolNoTone:Nl:Fd:Pt:La:Br:Kp:Ov:Mk;
     ref $IF = LO@76800MHzDPolNoTone:Ku:Kt:Ky;
     ref $IF = LO@99000MHzDPolNoTone:Kc;
     ref $BBC = 16BBCs:Ef:On;
     ref $BBC = 16BBCs#03:Mh;
     ref $BBC = 16BBCs#02:Pv;
     ref $BBC = 2BBCs:Nn;
     ref $BBC = 8BBCs#02:Gl:Mm;
     ref $BBC = 8BBCs:Nl:Fd:Pt:La:Br:Kp:Ov:Mk;
     ref $BBC = 16BBCs#04:Ax;
     ref $BBC = 8BBCs#03:Ku:Kt:Kc:Ky;
     ref $TRACKS = VDIF.16Ch2bit1to1:Ef:On:Mh:Pv:Ax:Ku:Kt:Kc:Ky;
     ref $TRACKS = VDIF.2Ch2bit1to1:Nn;
     ref $TRACKS = VDIF.8Ch2bit1to1#02:Gl:Mm;
     ref $TRACKS = VDIF.8Ch2bit1to1:Nl:Fd:Pt:La:Br:Kp:Ov:Mk;
*    ref $HEAD_POS = DiskVoid <= obsolete definition
     ref $ROLL = NoRoll:Ef:On:Mh:Pv:Nn:Gl:Nl:Fd:Pt:La:Br:Kp:Ov:Ax:Mk:Mm:Ku:Kt:Kc:Ky;
*    ref $PASS_ORDER = DiskVoid <= obsolete definition
     ref $PHASE_CAL_DETECT = NoDetect#02:Ef:On:Mh:Pv:Ax;
     ref $PHASE_CAL_DETECT = NoDetect#03:Nn;
     ref $PHASE_CAL_DETECT = NoDetect:Gl:Nl:Fd:Pt:La:Br:Kp:Ov:Mk:Mm;
     ref $PHASE_CAL_DETECT = NoDetect#04:Ku:Kt:Kc:Ky;
enddef;
*
def 43ghz;
     ref $PROCEDURES = Mode_02;
     ref $FREQ = 42912.00MHz8x128MHz:Nl:Fd:Pt:La:Br:Sc:Hn:Kp:Ov:Mk;
     ref $IF = LO@42400MHzDPolTone/1:Nl:Fd:Pt:La:Br:Sc:Hn:Kp:Ov:Mk;
     ref $BBC = 8BBCs#02:Nl:Fd:Pt:La:Br:Sc:Hn:Kp:Ov:Mk;
     ref $TRACKS = VDIF.8Ch2bit1to1:Nl:Fd:Pt:La:Br:Sc:Hn:Kp:Ov:Mk;
*    ref $HEAD_POS = DiskVoid <= obsolete definition
     ref $ROLL = NoRoll:Nl:Fd:Pt:La:Br:Sc:Hn:Kp:Ov:Mk;
*    ref $PASS_ORDER = DiskVoid <= obsolete definition
     ref $PHASE_CAL_DETECT = UsbDetect:Nl:Fd:Pt:La:Br:Sc:Hn:Kp:Ov:Mk;
enddef;
*------------------------------------------------------------------------------
$STATION;

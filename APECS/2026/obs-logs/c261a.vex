VEX_rev = 1.5;
*    SCHED vers: Release 12.0; March 2025
*    VEX/SCHED:  1.5.88
*    Other versions: Sched:  12.0  Plot: 1.06  JPL-ephem: 1.01
*------------------------------------------------------------------------------
$GLOBAL;
     ref $EXPER = c261a;
*                                                      +------------+
*                         PI revision number:          |    9.0000  |
*                                                      +------------+
*    mode:       4096-8-2
*------------------------------------------------------------------------------
$EXPER;
*
def c261a;
     exper_name = c261a;
     exper_description = "GMVA Apr. 2026";
     PI_name = "Global mm-VLBI Array (GMVA)";
     PI_email = hrottmann@mpifr-bonn.mpg.de;
*    address:   Max-Planck-Institut fuer Radioastronomie
*               Auf dem Huegel 69
*               53121 Bonn
*               Germany
*    phone:     0049-228-525-123
*    during obs:0049-2257-301-155
*    fax:       0049-2257-301-106
*    notes:     using Sched 12.0
*
*    year, doy: 2026, 106
*    date     : Thu 16 Apr 2026
*    MJD      : 61146
     exper_nominal_start=2026y106d16h00m00s;
     exper_nominal_stop=2026y107d15h37m00s;
*
     target_correlator = BONN;
*
*    integr_time    :     0.500 s
*    number_channels:   256
*    number_antenna : 20
*    cross_polarize : Yes
*    weight_func    : UNIFORM
*    distrib_medium : FTP
*    distrib_format : FITS
*    source_pos_cat : STANDARD
*    distribute_to  : 
*                     H. Rottmann
*                     Max-Planck-Institut fuer Radioastronomie
*                     Auf dem Huegel 69
*                     D-53121 Bonn, Germany
*    corr_notes : 
*               dual polarisation setup using 64/128 MHz channels
*               VLBA at 86 GHz, SiO maser pointing at 43 GHz
*               please use latest station coordinates
*
enddef;
*------------------------------------------------------------------------------
$MODE;
*
def 86ghz;
     ref $PROCEDURES = Mode_01;
     ref $FREQ = 86076.00MHz16x64MHz:Ef:On;
     ref $FREQ = 86076.00MHz16x64MHz#02:Ys:Mh:Ax;
     ref $FREQ = 86012.00MHz8x128MHz:Gl:La:Br:Nl:Fd:Pt:Kp:Ov:Mk;
     ref $FREQ = 86012.00MHz8x128MHz#02:Ky:Ku:Kt:Kc;
     ref $IF = LO@85500MHzDPolNoTone#03:Ef:On;
     ref $IF = LO@85500MHzDPolNoTone#04:Ys;
     ref $IF = LO@85500MHzDPolNoTone#05:Mh;
     ref $IF = LO@85500MHzDPolNoTone#02:Gl;
     ref $IF = LO@76800MHzDPolNoTone:Ky:Ku:Kt;
     ref $IF = LO@99000MHzDPolNoTone:Kc;
     ref $IF = LO@85500MHzDPolNoTone:La:Br:Nl:Fd:Pt:Kp:Ov:Mk;
     ref $IF = LO@85500MHzDPolNoTone#06:Ax;
     ref $BBC = 16BBCs:Ef:On;
     ref $BBC = 16BBCs#02:Ys;
     ref $BBC = 16BBCs#03:Mh;
     ref $BBC = 8BBCs#02:Gl;
     ref $BBC = 8BBCs#03:Ky:Ku:Kt:Kc;
     ref $BBC = 8BBCs:La:Br:Nl:Fd:Pt:Kp:Ov:Mk;
     ref $BBC = 16BBCs#04:Ax;
     ref $TRACKS = VDIF.16Ch2bit1to1:Ef:On:Ys:Mh:Ax;
     ref $TRACKS = VDIF.8Ch2bit1to1#02:Gl:Ky:Ku:Kt:Kc;
     ref $TRACKS = VDIF.8Ch2bit1to1:La:Br:Nl:Fd:Pt:Kp:Ov:Mk;
*    ref $HEAD_POS = DiskVoid <= obsolete definition
     ref $ROLL = NoRoll:Ef:On:Ys:Mh:Gl:Ky:Ku:Kt:Kc:La:Br:Ax:Nl:Fd:Pt:Kp:Ov:Mk;
*    ref $PASS_ORDER = DiskVoid <= obsolete definition

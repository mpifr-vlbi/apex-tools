     ref $PHASE_CAL_DETECT = NoDetect:Gl:La:Br:Nl:Fd:Pt:Kp:Ov:Mk;
     ref $PHASE_CAL_DETECT = NoDetect#03:Ky:Ku:Kt:Kc;
enddef;

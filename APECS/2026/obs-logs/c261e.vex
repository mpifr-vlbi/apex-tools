$EXPER;
*
def c261e;
     exper_name = c261e;
     exper_description = "GMVA Apr. 2026";
     PI_name = "Global mm-VLBI Array (GMVA)";
     PI_email = hrottmann@mpifr-bonn.mpg.de;
*    address:   Max-Planck-Institut fuer Radioastronomie
*               Auf dem Huegel 69
*               53121 Bonn
*               Germany
*    phone:     0049-228-525-123
*    during obs:0049-2257-301-155
*    fax:       0049-2257-301-106
*    notes:     using Sched 12.0
*
*    year, doy: 2026, 110
*    date     : Mon 20 Apr 2026
*    MJD      : 61150
     exper_nominal_start=2026y110d11h40m00s;
     exper_nominal_stop=2026y111d07h53m40s;
*
     target_correlator = BONN;
*
*    integr_time    :     0.500 s
*    number_channels:   256
*    number_antenna : 20
*    cross_polarize : Yes
*    weight_func    : UNIFORM
*    distrib_medium : FTP
*    distrib_format : FITS
*    source_pos_cat : STANDARD
*    distribute_to  : 
*                     H. Rottmann
*                     Max-Planck-Institut fuer Radioastronomie
*                     Auf dem Huegel 69
*                     D-53121 Bonn, Germany
*    corr_notes : 
*               dual polarisation setup using 64/128 MHz channels
*               VLBA at 86 GHz, SiO maser pointing at 43 GHz
*               please use latest station coordinates
*
enddef;
*------------------------------------------------------------------------------
$MODE;
*
def 86ghz;
     ref $PROCEDURES = Mode_01;
     ref $FREQ = 86076.00MHz16x64MHz:Ef:On;
     ref $FREQ = 86076.00MHz16x64MHz#02:Ys:Mh:Ax;
     ref $FREQ = 86012.00MHz8x128MHz:Gl:Gb:Nl:Fd:Pt:La:Kp:Ov:Br:Mk:Hs;
     ref $FREQ = 86012.00MHz8x128MHz#02:Ky:Ku:Kt:Kc;
     ref $IF = LO@85500MHzDPolNoTone#04:Ef:On;
     ref $IF = LO@85500MHzDPolNoTone#05:Ys;
     ref $IF = LO@85500MHzDPolNoTone#06:Mh;
     ref $IF = LO@85500MHzDPolNoTone#03:Gl:Hs;

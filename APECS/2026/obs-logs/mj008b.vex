*    mode:       4096-8-2
*------------------------------------------------------------------------------
$EXPER;
*
def mj008b;
     exper_name = mj008b;
     exper_description = "GMVA Apr. 2026";
     PI_name = "Global mm-VLBI Array (GMVA)";
     PI_email = hrottmann@mpifr-bonn.mpg.de;
*    address:   Max-Planck-Institut fuer Radioastronomie
*               Auf dem Huegel 69
*               53121 Bonn
*               Germany
*    phone:     0049-228-525-123
*    during obs:0049-2257-301-155
*    fax:       0049-2257-301-106
*    notes:     using Sched 12.0
*
*    year, doy: 2026, 111
*    date     : Tue 21 Apr 2026
*    MJD      : 61151
     exper_nominal_start=2026y111d06h48m00s;
     exper_nominal_stop=2026y111d13h59m15s;
*
     target_correlator = BONN;
*
*    integr_time    :     0.500 s
*    number_channels:   256
*    number_antenna : 20
*    cross_polarize : Yes
*    weight_func    : UNIFORM
*    distrib_medium : FTP
*    distrib_format : FITS
*    source_pos_cat : STANDARD
*    distribute_to  : 
*                     H. Rottmann
*                     Max-Planck-Institut fuer Radioastronomie
*                     Auf dem Huegel 69
*                     D-53121 Bonn, Germany
*    corr_notes : 
*               dual polarisation setup using 64/128 MHz channels
*               VLBA at 86 GHz, SiO maser pointing at 43 GHz
*               please use latest station coordinates
*
enddef;
*------------------------------------------------------------------------------
$MODE;
*
def 86ghz;
     ref $PROCEDURES = Mode_01;
     ref $FREQ = 86012.00MHz8x128MHz:Gb:Aa:Nl:Fd:Pt:La:Ov:Kp:Br:Lm:Hs:Mk:Mm;
     ref $FREQ = 86076.00MHz16x64MHz:Ax;
     ref $IF = LO@85500MHzDPolNoTone#02:Gb;
     ref $IF = LO@85500MHzDPolNoTone#04:Aa;
     ref $IF = LO@85500MHzDPolNoTone#05:Ax;
     ref $IF = LO@85500MHzDPolNoTone:Nl:Fd:Pt:La:Ov:Kp:Br:Mk;
     ref $IF = LO@85500MHzDPolNoTone#03:Lm:Hs:Mm;
     ref $BBC = 8BBCs#02:Gb:Lm:Hs:Mm;
     ref $BBC = 8BBCs#03:Aa;
     ref $BBC = 16BBCs:Ax;
     ref $BBC = 8BBCs:Nl:Fd:Pt:La:Ov:Kp:Br:Mk;
     ref $TRACKS = VDIF.8Ch2bit1to1:Gb:Nl:Fd:Pt:La:Ov:Kp:Br:Mk;
     ref $TRACKS = VDIF.8Ch2bit1to1#02:Aa:Lm:Hs:Mm;
     ref $TRACKS = VDIF.16Ch2bit1to1:Ax;
*    ref $HEAD_POS = DiskVoid <= obsolete definition
     ref $ROLL = NoRoll:Gb:Aa:Ax:Nl:Fd:Pt:La:Ov:Kp:Br:Lm:Hs:Mk:Mm;
*    ref $PASS_ORDER = DiskVoid <= obsolete definition
     ref $PHASE_CAL_DETECT = NoDetect:Gb:Aa:Nl:Fd:Pt:La:Ov:Kp:Br:Lm:Hs:Mk:Mm;
     ref $PHASE_CAL_DETECT = NoDetect#02:Ax;
enddef;

     ref $FREQ = 42912.00MHz8x128MHz#02:Ku:Kt:Kc:Ky;
     ref $FREQ = 42912.00MHz8x128MHz:Nl:Fd:Pt:La:Kp:Ov:Br:Mk:Sc:Hn;
     ref $IF = LO@34110MHzDPolNoTone:Ku:Kt:Kc:Ky;
     ref $IF = LO@42400MHzDPolTone/1:Nl:Fd:Pt:La:Kp:Ov:Br:Mk:Sc:Hn;
     ref $BBC = 8BBCs#04:Ku:Kt:Kc:Ky;
     ref $BBC = 8BBCs#02:Nl:Fd:Pt:La:Kp:Ov:Br:Mk:Sc:Hn;
     ref $TRACKS = VDIF.8Ch2bit1to1#02:Ku:Kt:Kc:Ky;
     ref $TRACKS = VDIF.8Ch2bit1to1:Nl:Fd:Pt:La:Kp:Ov:Br:Mk:Sc:Hn;

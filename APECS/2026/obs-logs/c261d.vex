VEX_rev = 1.5;
*    SCHED vers: Release 12.0; March 2025
*    VEX/SCHED:  1.5.88
*    Other versions: Sched:  12.0  Plot: 1.06  JPL-ephem: 1.01
*------------------------------------------------------------------------------
$GLOBAL;
     ref $EXPER = c261d;
*                                                      +------------+
*                         PI revision number:          |    5.0000  |
*                                                      +------------+
*    mode:       4096-8-2
*------------------------------------------------------------------------------
$EXPER;
*
def c261d;
     exper_name = c261d;
     exper_description = "GMVA Apr. 2026";
     PI_name = "Global mm-VLBI Array (GMVA)";
     PI_email = hrottmann@mpifr-bonn.mpg.de;
*    address:   Max-Planck-Institut fuer Radioastronomie
*               Auf dem Huegel 69
*               53121 Bonn
*               Germany
*    phone:     0049-228-525-123
*    during obs:0049-2257-301-155
*    fax:       0049-2257-301-106
*    notes:     using Sched 12.0
*
*    year, doy: 2026, 109
*    date     : Sun 19 Apr 2026
*    MJD      : 61149
     exper_nominal_start=2026y109d19h30m00s;
     exper_nominal_stop=2026y110d15h44m40s;
*
     target_correlator = BONN;
*
*    integr_time    :     0.500 s
*    number_channels:   256
*    number_antenna : 20
*    cross_polarize : Yes
*    weight_func    : UNIFORM
*    distrib_medium : FTP
*    distrib_format : FITS
*    source_pos_cat : STANDARD
*    distribute_to  : 
*                     H. Rottmann
*                     Max-Planck-Institut fuer Radioastronomie
*                     Auf dem Huegel 69
*                     D-53121 Bonn, Germany
*    corr_notes : 
*               dual polarisation setup using 64/128 MHz channels
*               VLBA at 86 GHz, SiO maser pointing at 43 GHz
*               please use latest station coordinates
*
enddef;
*------------------------------------------------------------------------------
$MODE;
*
def 86ghz;
     ref $PROCEDURES = Mode_01;
     ref $FREQ = 86076.00MHz16x64MHz:Ef:On;
     ref $FREQ = 86076.00MHz16x64MHz#02:Mh:Ys:Ax;
     ref $FREQ = 86012.00MHz8x128MHz:Gl:Nl:Fd:Pt:La:Kp:Ov:Br:Mk;
     ref $FREQ = 86012.00MHz8x128MHz#02:Ku:Kt:Kc:Ky;
     ref $IF = LO@85500MHzDPolNoTone#03:Ef:On;
     ref $IF = LO@85500MHzDPolNoTone#05:Mh;
     ref $IF = LO@85500MHzDPolNoTone#04:Ys;
     ref $IF = LO@85500MHzDPolNoTone#02:Gl;
     ref $IF = LO@76800MHzDPolNoTone:Ku:Kt:Ky;
     ref $IF = LO@99000MHzDPolNoTone:Kc;
     ref $IF = LO@85500MHzDPolNoTone#06:Ax;
     ref $IF = LO@85500MHzDPolNoTone:Nl:Fd:Pt:La:Kp:Ov:Br:Mk;
     ref $BBC = 16BBCs:Ef:On;
     ref $BBC = 16BBCs#03:Mh;
     ref $BBC = 16BBCs#02:Ys;
     ref $BBC = 8BBCs#02:Gl;
     ref $BBC = 8BBCs#03:Ku:Kt:Kc:Ky;
     ref $BBC = 16BBCs#04:Ax;
     ref $BBC = 8BBCs:Nl:Fd:Pt:La:Kp:Ov:Br:Mk;
     ref $TRACKS = VDIF.16Ch2bit1to1:Ef:On:Mh:Ys:Ax;
     ref $TRACKS = VDIF.8Ch2bit1to1#02:Gl:Ku:Kt:Kc:Ky;
     ref $TRACKS = VDIF.8Ch2bit1to1:Nl:Fd:Pt:La:Kp:Ov:Br:Mk;
*    ref $HEAD_POS = DiskVoid <= obsolete definition
     ref $ROLL = NoRoll:Ef:On:Mh:Ys:Gl:Ku:Kt:Kc:Ky:Ax:Nl:Fd:Pt:La:Kp:Ov:Br:Mk;
*    ref $PASS_ORDER = DiskVoid <= obsolete definition
     ref $PHASE_CAL_DETECT = NoDetect#02:Ef:On:Mh:Ys:Ax;
     ref $PHASE_CAL_DETECT = NoDetect:Gl:Nl:Fd:Pt:La:Kp:Ov:Br:Mk;
     ref $PHASE_CAL_DETECT = NoDetect#03:Ku:Kt:Kc:Ky;
enddef;
*
def 43ghz;

     ref $FREQ = 86012.00MHz8x128MHz#02:Ky:Ku:Kt:Kc;
     ref $FREQ = 86012.00MHz2x512MHz:Mp;
     ref $FREQ = 86076.00MHz16x64MHz#02:Tm:Ys:Mh:Ax;
     ref $FREQ = 86076.00MHz16x64MHz:Ef:On;
     ref $FREQ = 86012.00MHz8x128MHz:Gl:Gb:Aa:Lm:Nl:Fd:Pt:La:Kp:Ov:Br:Mk:Mm;
     ref $IF = LO@76800MHzDPolNoTone:Ky:Ku:Kt;
     ref $IF = LO@99000MHzDPolNoTone:Kc;
     ref $IF = LO@92800MHzDPolNoTone:Mp;
     ref $IF = LO@85500MHzDPolNoTone#04:Tm:Mh:Aa;
     ref $IF = LO@85500MHzDPolNoTone#05:Ef:On;

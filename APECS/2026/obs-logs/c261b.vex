     ref $IF = LO@85500MHzDPolNoTone:Nl:Fd:Pt:La:Kp:Ov:Br:Mk;
     ref $BBC = 8BBCs#04:Ky:Ku:Kt:Kc;
     ref $BBC = 2BBCs:Mp;
     ref $BBC = 16BBCs#03:Tm:Mh;
     ref $BBC = 16BBCs:Ef:On;
     ref $BBC = 16BBCs#02:Ys;
     ref $BBC = 8BBCs#02:Gl:Gb:Lm:Mm;
     ref $BBC = 16BBCs#04:Ax;
     ref $BBC = 8BBCs#03:Aa;
     ref $BBC = 8BBCs:Nl:Fd:Pt:La:Kp:Ov:Br:Mk;
     ref $TRACKS = VDIF.8Ch2bit1to1#02:Ky:Ku:Kt:Kc:Gl:Aa:Lm:Mm;
     ref $TRACKS = VDIF.2Ch2bit1to1:Mp;
     ref $TRACKS = VDIF.16Ch2bit1to1:Tm:Ef:On:Ys:Mh:Ax;
     ref $TRACKS = VDIF.8Ch2bit1to1:Gb:Nl:Fd:Pt:La:Kp:Ov:Br:Mk;
